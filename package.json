{
  "name": "@cubescope/web",
  "version": "0.1.0-alpha.1",
  "description": "CubeScope is a browser-native, local-first, hardware-accelerated hyperspectral viewer kernel for ENVI datasets.",
  "type": "module",
  "main": "dist/cubescope.es.js",
  "module": "dist/cubescope.es.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/cubescope.es.js",
      "default": "./dist/cubescope.es.js"
    },
    "./worker.js": "./dist/worker.js",
    "./pkg/envi_parser.js": "./dist/pkg/envi_parser.js",
    "./pkg/envi_parser_bg.wasm": "./dist/pkg/envi_parser_bg.wasm",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "clean": "node scripts/clean-dist.mjs",
    "fixtures:generate": "node scripts/generate-test-fixtures.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:sdk": "vite build",
    "build:worker": "vite build --config vite.worker.config.js",
    "build:assets": "node scripts/copy-runtime-assets.mjs",
    "build": "npm run build:wasm && npm run clean && npm run build:sdk && npm run build:worker && npm run build:assets",
    "test:unit": "vitest run",
    "test:smoke": "playwright test",
    "test": "npm run test:unit && npm run test:smoke",
    "benchmark": "node scripts/benchmark/run-benchmarks.mjs",
    "verify:alpha": "npm run fixtures:generate && npm run build && npm run test"
  },
  "keywords": [
    "cubescope",
    "envi",
    "hyperspectral",
    "remote-sensing",
    "webgpu",
    "wasm",
    "web-workers"
  ],
  "author": "Yongyin Leon Li and contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yongyin-leon/CubeScope.git"
  },
  "homepage": "https://github.com/yongyin-leon/CubeScope",
  "bugs": {
    "url": "https://github.com/yongyin-leon/CubeScope/issues"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "jsdom": "^26.1.0",
    "vite": "^8.0.8",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "CITATION.cff"
  ]
}
